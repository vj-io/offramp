"""NVIDIA Nemotron on Nebius Token Factory (added by Offramp).

Token Factory is OpenAI-compatible, so migrated call sites use the OpenAI SDK with the client below.
Nemotron reasons by default: every call passes
extra_body={"chat_template_kwargs": {"enable_thinking": <bool>}} explicitly.
"""

import os

from openai import OpenAI

NEBIUS_BASE_URL = "https://api.tokenfactory.nebius.com/v1"

# Nemotron tiers on Token Factory, cheapest first (model ids as listed by GET /v1/models).
LIGHTNING = "$lightning"
SUPER = "$super"
ULTRA = "$ultra"


def token_factory_client() -> OpenAI:
    """OpenAI SDK client for Token Factory; reads NEBIUS_API_KEY (and NEBIUS_BASE_URL, if set)."""
    return OpenAI(
        api_key=os.environ["NEBIUS_API_KEY"],
        base_url=os.environ.get("NEBIUS_BASE_URL", NEBIUS_BASE_URL),
    )
