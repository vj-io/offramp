# --- Nebius Token Factory (required for live runs; OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Tier -> model id overrides (defaults live in offramp/tf/tiers.py; verify with GET /v1/models)
# OFFRAMP_MODEL_LIGHTNING=
# OFFRAMP_MODEL_SUPER=
# OFFRAMP_MODEL_ULTRA=


# --- GitHub PR builder (fine-grained PAT, contents+pull-requests write on the demo repo only) ---
GITHUB_TOKEN=
OFFRAMP_DEMO_REPO=vj-io/offramp-demo-app

# --- Hackathon credit integrations (paste keys here) ---
# Tavily: https://app.tavily.com  (runtime price/deprecation lookup — Best Use of Tavily)
TAVILY_API_KEY=
# LangSmith (LangChain): https://smith.langchain.com -> Settings -> API Keys (tracing + eval datasets)
LANGSMITH_API_KEY=
# true traces every Token Factory call; set it only together with LANGSMITH_API_KEY
LANGSMITH_TRACING=
LANGSMITH_PROJECT=offramp
# 1 makes the report and PR link PUBLIC share links of each site's dataset (its prompts and inputs); unset: private URLs only
OFFRAMP_LANGSMITH_PUBLIC=

# --- Nebius Serverless Jobs (optional; local worker fallback when unset) ---
NEBIUS_PROJECT_ID=
OFFRAMP_EVAL_IMAGE=
# MysteryBox secret ids holding NEBIUS_API_KEY (and its fallback) for the job: the key never goes on a command line
NEBIUS_JOB_SECRET_ID=
NEBIUS_JOB_SECRET_ID_FALLBACK=

# --- Server ---
OFFRAMP_DATA_DIR=./var
OFFRAMP_RATE_LIMIT_PER_MIN=30
# Web origin(s) allowed by CORS, comma-separated (default http://localhost:3000)
OFFRAMP_WEB_ORIGIN=
# 1 lets POST /api/runs start runs, cache-only or live (a run clones the repo, runs its code in the sandbox, can open a PR); off by default
OFFRAMP_ALLOW_LIVE_RUNS=
# 1 lets target-repo code (its tests, Pydantic schemas, oracles) run on this machine when Docker is unavailable: not isolated, trusted repos only
OFFRAMP_ALLOW_LOCAL_SANDBOX=

# Tendem by Toloka: https://agent.tendem.ai/mcp -> "Connect any MCP client with your own API key" -> Generate API key (sent as "Authorization: ApiKey <key>")
# Not read by Offramp's code: scripts/audit_references.py only writes the task and reads verdicts as files
TENDEM_API_KEY=
# Toloka: the new platform.toloka.ai (beta) has no API keys; label checks run as a UI "Data labeling" project. Not read by any code; leave blank.
TOLOKA_API_KEY=

# --- Fallback keys (second account). Used only when the primary key is rejected or out of credit
# (HTTP 401/402/403, or 429 with a quota/credit message); the switch is logged without the key. ---
NEBIUS_API_KEY_FALLBACK=
TAVILY_API_KEY_FALLBACK=
LANGSMITH_API_KEY_FALLBACK=
TENDEM_API_KEY_FALLBACK=
