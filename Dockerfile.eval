# Image for the eval matrix as a Nebius Serverless Job (PRD §6.5). Build from the repo root:
#   docker build -f Dockerfile.eval -t offramp-eval .
# The Token Factory key is NOT part of the image: submit.py passes it at run time (`nebius ai job create --env`).
# The matrix and the Token Factory cache arrive as `--inject-file` parts, the results leave on stdout.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app PYTHONUNBUFFERED=1

# Dependencies from the lockfile (the versions the tests ran with), without the project itself
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY offramp ./offramp

ENTRYPOINT ["python", "-m", "offramp.evals.serverless_job.main"]
